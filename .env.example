# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# Local MongoDB, or an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/sheher_transit

# Long random string used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=12h

# Comma-separated list of origins allowed to call the API / connect via Socket.IO
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Must match the client ID used on the frontend (.env there).
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id
